# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
# Optional: comma-separated list of allowed chat IDs
# TELEGRAM_ALLOWED_CHAT_IDS=12345678,87654321

# Antigravity IDE Conversation ID (for free-form chat relay via agentapi)
CONVERSATION_ID=your_antigravity_conversation_id_here

# Pipeline Engine: 'claude' (headless Claude Code via claude -p) or 'antigravity'
PIPELINE_ENGINE=claude

# Optional configuration
# CLAUDE_BIN=/path/to/claude
# PIPELINE_PERMISSION_MODE=dontAsk
# PIPELINE_TIMEOUT_MIN=240
# VALUE_PIPELINE_KEY_FILE=~/.config/value-pipeline/provenance.key
